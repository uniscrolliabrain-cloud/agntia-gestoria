# Copia este archivo a .env y rellena solo lo que necesites.
# Nunca subas .env al repositorio ni pegues credenciales reales en un chat.

# --- Servicio ---------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
GESTORIA_DATA_DIR=./.agente

# --- Acceso ----------------------------------------------------------------
# Token del propietario. Cámbialo antes de exponer el servicio fuera de tu máquina.
GESTORIA_OWNER_TOKEN=cambia-esto-por-un-token-largo
# Actores con rol y empresas: {"token": {"id": "luis", "role": "reviewer", "companies": ["<hex32>"]}}
GESTORIA_ACTORS_JSON={}
# No activar fuera de desarrollo local: deja entrar como propietario a 127.0.0.1.
GESTORIA_ALLOW_LOCAL_OWNER=false

# --- RR. HH. ---------------------------------------------------------------
# Empresas con el módulo encendido. Sin esta bandera la API responde 404.
GESTORIA_RRHH_JSON={}
GESTORIA_RRHH_SECTOR=hosteleria
GESTORIA_RRHH_PACKS=./tests/fixtures/rrhh/packs

# --- Agente de ciberseguridad (solo lectura) -------------------------------
# Webhook de chat (Slack/Teams/Matrix...). Si está vacío, los avisos quedan en memoria.
GESTORIA_SECURITY_CHAT_WEBHOOK=

# --- Odoo (solo laboratorio) ----------------------------------------------
ODOO_URL=http://localhost:8069
ODOO_DB=lab_gestoria
ODOO_USER=admin
ODOO_PASSWORD=admin

# --- Laboratorio Docker ----------------------------------------------------
LAB_PG_DB=postgres
LAB_PG_USER=odoo
LAB_PG_PASSWORD=odoo_lab
LAB_PG_PORT=5433
LAB_ODOO_PORT=8069
