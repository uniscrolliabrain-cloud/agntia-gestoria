diff --git a/tests/test_auth_local_owner.py b/tests/test_auth_local_owner.py
new file mode 100644
index 0000000..0b681b6
--- /dev/null
+++ b/tests/test_auth_local_owner.py
@@ -0,0 +1,42 @@
+import pytest
+from fastapi import HTTPException
+from starlette.requests import Request
+
+from agntia_gestoria import auth
+
+
+def request_from(host):
+    return Request({'type': 'http', 'method': 'GET', 'path': '/', 'headers': [],
+                    'client': (host, 5000), 'scheme': 'http', 'server': ('testserver', 80)})
+
+
+def no_credentials(monkeypatch):
+    monkeypatch.delenv('GESTORIA_OWNER_TOKEN', raising=False)
+    monkeypatch.setenv('GESTORIA_ACTORS_JSON', '{}')
+
+
+def test_loopback_is_not_owner_without_explicit_permission(monkeypatch):
+    no_credentials(monkeypatch)
+    monkeypatch.delenv('GESTORIA_ALLOW_LOCAL_OWNER', raising=False)
+    with pytest.raises(HTTPException) as error:
+        auth.authenticate(request_from('127.0.0.1'))
+    assert error.value.status_code == 403
+
+
+def test_loopback_is_owner_with_explicit_permission(monkeypatch):
+    no_credentials(monkeypatch)
+    monkeypatch.setenv('GESTORIA_ALLOW_LOCAL_OWNER', 'true')
+    actor = auth.authenticate(request_from('127.0.0.1'))
+    assert actor.role == 'owner' and actor.id == 'local-owner'
+
+
+def test_remote_client_is_never_owner(monkeypatch):
+    no_credentials(monkeypatch)
+    monkeypatch.setenv('GESTORIA_ALLOW_LOCAL_OWNER', 'true')
+    with pytest.raises(HTTPException):
+        auth.authenticate(request_from('203.0.113.9'))
+
+
+def test_testclient_keeps_working_for_the_suite(monkeypatch):
+    no_credentials(monkeypatch)
+    assert auth.authenticate(request_from('testclient')).id == 'local-owner'
diff --git a/tests/test_storage_hardening.py b/tests/test_storage_hardening.py
new file mode 100644
index 0000000..f663d93
--- /dev/null
+++ b/tests/test_storage_hardening.py
@@ -0,0 +1,45 @@
+import pytest
+
+from agntia_gestoria.storage import Database, canonical
+
+CID = 'a' * 32
+OTHER = 'b' * 32
+
+
+def database(tmp_path):
+    db = Database(str(tmp_path))
+    with db.transaction() as connection:
+        for cid in (CID, OTHER):
+            connection.execute('INSERT INTO companies(id,body) VALUES(?,?)',
+                               (cid, canonical({'id': cid, 'name': cid[:4]})))
+    return db
+
+
+def test_put_updates_the_logical_key_on_conflict(tmp_path):
+    db = database(tmp_path)
+    body = {'id': '1' * 32, 'company_id': CID, 'value': 1}
+    with db.transaction() as connection:
+        Database.put(connection, CID, 'demo', body, unique_key='k1')
+        Database.put(connection, CID, 'demo', dict(body, value=2), unique_key='k2')
+        row = connection.execute(
+            'SELECT body,unique_key FROM objects WHERE id=?', (body['id'],)).fetchone()
+    assert row['unique_key'] == 'k2'
+    assert '"value":2' in row['body']
+
+
+def test_put_refuses_an_identifier_from_another_company(tmp_path):
+    db = database(tmp_path)
+    body = {'id': '2' * 32, 'company_id': CID, 'value': 1}
+    with db.transaction() as connection:
+        Database.put(connection, CID, 'demo', body)
+        with pytest.raises(PermissionError):
+            Database.put(connection, OTHER, 'demo', dict(body, company_id=OTHER))
+        with pytest.raises(PermissionError):
+            Database.put(connection, OTHER, 'otro', dict(body, company_id=OTHER))
+
+
+def test_put_refuses_a_body_from_another_company(tmp_path):
+    db = database(tmp_path)
+    with db.transaction() as connection:
+        with pytest.raises(ValueError):
+            Database.put(connection, CID, 'demo', {'id': '3' * 32, 'company_id': OTHER})
