@@ -0,0 +1,129 @@
+"""Opt-in SQLite migrations for the Odoo integration."""
+
+from contextlib import closing
+import hashlib
+import os
+from pathlib import Path
+import sqlite3
+import tempfile
+
+from agntia_gestoria.storage import Database
+
+
+MIGRATIONS = (
+    (
+        """
+        CREATE TABLE odoo_company_scopes (
+            company_id TEXT PRIMARY KEY NOT NULL REFERENCES companies(id),
+            tenant_id TEXT NOT NULL,
+            UNIQUE (tenant_id, company_id)
+        )
+        """,
+        """
+        CREATE TABLE odoo_connections (
+            id TEXT PRIMARY KEY NOT NULL,
+            tenant_id TEXT NOT NULL,
+            company_id TEXT NOT NULL,
+            endpoint_ref TEXT NOT NULL,
+            database_ref TEXT NOT NULL,
+            credential_ref TEXT NOT NULL,
+            odoo_company_id INTEGER NOT NULL CHECK (typeof(odoo_company_id) = 'integer' AND odoo_company_id BETWEEN 1 AND 2147483647),
+            state TEXT NOT NULL CHECK (state IN ('pending_validation', 'active', 'disabled')),
+            revision INTEGER NOT NULL CHECK (typeof(revision) = 'integer' AND revision BETWEEN 0 AND 2147483647),
+            created_at TEXT NOT NULL,
+            UNIQUE (tenant_id, company_id, id),
+            UNIQUE (endpoint_ref, database_ref, odoo_company_id),
+            FOREIGN KEY (tenant_id, company_id) REFERENCES odoo_company_scopes(tenant_id, company_id)
+        )
+        """,
+        """
+        CREATE TABLE odoo_sync_cursors (
+            tenant_id TEXT NOT NULL,
+            company_id TEXT NOT NULL,
+            connection_id TEXT NOT NULL,
+            model TEXT NOT NULL CHECK (model IN ('res.partner', 'account.move', 'account.move.line', 'ir.attachment')),
+            write_date TEXT NOT NULL,
+            remote_id INTEGER NOT NULL CHECK (typeof(remote_id) = 'integer' AND remote_id BETWEEN 1 AND 2147483647),
+            PRIMARY KEY (tenant_id, company_id, connection_id, model),
+            FOREIGN KEY (tenant_id, company_id, connection_id)
+                REFERENCES odoo_connections(tenant_id, company_id, id)
+        )
+        """,
+        """
+        CREATE TABLE odoo_contact_operations (
+            id TEXT PRIMARY KEY NOT NULL,
+            tenant_id TEXT NOT NULL,
+            company_id TEXT NOT NULL,
+            connection_id TEXT NOT NULL,
+            connection_revision INTEGER NOT NULL CHECK (typeof(connection_revision) = 'integer' AND connection_revision BETWEEN 0 AND 2147483647),
+            idempotency_key TEXT NOT NULL,
+            preview_id TEXT NOT NULL,
+            preview_hash TEXT NOT NULL,
+            approval_id TEXT NOT NULL,
+            actor_id TEXT NOT NULL,
+            correlation_id TEXT NOT NULL,
+            state TEXT NOT NULL CHECK (state IN ('pending', 'in_flight', 'succeeded', 'rejected', 'reconciliation_required')),
+            remote_id INTEGER CHECK (remote_id IS NULL OR (typeof(remote_id) = 'integer' AND remote_id BETWEEN 1 AND 2147483647)),
+            created_at TEXT NOT NULL,
+            updated_at TEXT NOT NULL,
+            CHECK ((state = 'succeeded') = (remote_id IS NOT NULL)),
+            UNIQUE (tenant_id, company_id, connection_id, idempotency_key),
+            FOREIGN KEY (tenant_id, company_id, connection_id)
+                REFERENCES odoo_connections(tenant_id, company_id, id)
+        )
+        """,
+    ),
+)
+
+
+def _apply(connection: sqlite3.Connection, migrations: tuple[tuple[str, ...], ...]) -> int:
+    connection.execute("""
+        CREATE TABLE IF NOT EXISTS odoo_schema_migrations (
+            version INTEGER PRIMARY KEY CHECK (version > 0),
+            checksum TEXT NOT NULL
+        )
+    """)
+    expected = [
+        (version, hashlib.sha256("\0".join(statements).encode()).hexdigest())
+        for version, statements in enumerate(migrations, start=1)
+    ]
+    applied = [
+        tuple(row) for row in connection.execute(
+            "SELECT version, checksum FROM odoo_schema_migrations ORDER BY version"
+        )
+    ]
+    if applied != expected[:len(applied)]:
+        raise RuntimeError("Incompatible Odoo migration history")
+    for version, checksum in expected[len(applied):]:
+        for statement in migrations[version - 1]:
+            connection.execute(statement)
+        connection.execute(
+            "INSERT INTO odoo_schema_migrations(version, checksum) VALUES (?, ?)", (version, checksum)
+        )
+    return len(expected)
+
+
+def migrate(database: Database) -> int:
+    """Apply the missing migrations atomically under the existing write lock."""
+    with database.transaction() as connection:
+        return _apply(connection, MIGRATIONS)
+
+
+def backup(database: Database, destination: Path) -> Path:
+    """Publish a consistent SQLite backup without overwriting an existing file."""
+    destination = destination.absolute()
+    if destination.exists() or destination.is_symlink():
+        raise FileExistsError(destination)
+    fd, filename = tempfile.mkstemp(prefix=".odoo-backup-", dir=destination.parent)
+    os.close(fd)
+    temporary = Path(filename)
+    try:
+        with database.connection() as source, closing(sqlite3.connect(temporary)) as target:
+            source.backup(target)
+            if target.execute("PRAGMA integrity_check").fetchall() != [("ok",)]:
+                raise RuntimeError("SQLite backup integrity check failed")
+        # The hard link publishes a complete backup and fails if another caller won.
+        os.link(temporary, destination)
+        return destination
+    finally:
+        temporary.unlink()
diff --git a/agntia_gestoria/integrations/registry.py b/agntia_gestoria/integrations/registry.py
new file mode 100644
index 0000000..1dccf9d
--- /dev/null
+++ b/agntia_gestoria/integrations/registry.py
@@ -0,0 +1,221 @@
+"""Server-side connection registry. No transport and no network side effects."""
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+import ipaddress
+import re
+import sqlite3
+from typing import Literal
+from urllib.parse import urlsplit
+
+from pydantic import SecretStr
+
+from agntia_gestoria.integrations.contracts import Contract, LocalId, OdooBinding, PublicConnection, Revision, Scope
+from agntia_gestoria.storage import Database, now
+
+
+class RegistryError(Exception):
+    def __init__(self, code: str):
+        self.code = code
+        super().__init__(code)
+
+
+class Principal(Contract):
+    """Trusted server principal. Construct only after checking membership."""
+
+    scope: Scope
+    role: Literal["owner", "reviewer", "agent", "viewer"]
+
+
+class ConnectionChange(Contract):
+    connection_id: LocalId
+    expected_revision: Revision
+
+
+@dataclass(frozen=True)
+class ResolvedConnection:
+    public: PublicConnection
+    origin: str = field(repr=False)
+    database_name: str = field(repr=False)
+    api_key: SecretStr = field(repr=False)
+    odoo_company_id: int = field(repr=False)
+
+
+def approved_origin(value: str, allowed_hosts: frozenset[str], allow_test_loopback: bool) -> str:
+    if not value.isascii() or any(not 33 <= ord(character) <= 126 for character in value) or any(
+        character in value for character in "\\%?#"
+    ):
+        raise ValueError("Invalid Odoo origin")
+    try:
+        url = urlsplit(value)
+        host = url.hostname
+        port = url.port
+    except ValueError:
+        raise ValueError("Invalid Odoo origin") from None
+    if not host or url.username is not None or url.password is not None or url.path not in ("", "/") or port == 0:
+        raise ValueError("Invalid Odoo origin")
+    try:
+        address = ipaddress.ip_address(host)
+    except ValueError:
+        address = None
+    if address is not None:
+        if not (allow_test_loopback and url.scheme == "http" and host in ("127.0.0.1", "::1")):
+            raise ValueError("Invalid Odoo origin")
+    elif (
+        url.scheme != "https" or host not in allowed_hosts or len(host) > 253 or "." not in host
+        or any(not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label) for label in host.split("."))
+        or not re.search(r"[a-z]", host.rsplit(".", 1)[-1])
+        or all(re.fullmatch(r"(?:[0-9]+|0x[0-9a-f]+)", label) for label in host.split("."))
+    ):
+        raise ValueError("Invalid Odoo origin")
+    authority = f"[{host}]" if ":" in host else host
+    if url.netloc.lower() != (f"{authority}:{port}" if port is not None else authority):
+        raise ValueError("Invalid Odoo origin")
+    default_port = 443 if url.scheme == "https" else 80
+    suffix = f":{port}" if port is not None and port != default_port else ""
+    return f"{url.scheme}://{authority}{suffix}"
+
+
+class ServerCatalog:
+    """Validate and snapshot configuration supplied by the service operator."""
+
+    def __init__(
+        self,
+        endpoints: Mapping[str, str],
+        databases: Mapping[str, str],
+        credential_refs: set[str],
+        read_secret: Callable[[str], str | None],
+        *,
+        allowed_hosts: frozenset[str],
+        allow_test_loopback: bool = False,
+    ):
+        self._endpoints = {
+            ref: approved_origin(value, allowed_hosts, allow_test_loopback) for ref, value in endpoints.items()
+        }
+        self._databases = dict(databases)
+        self._credential_refs = frozenset(credential_refs)
+        self._read_secret = read_secret
+        if any(not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_-]{0,62}", name) for name in self._databases.values()):
+            raise ValueError("Invalid Odoo database configuration")
+        if (
+            len(set(self._endpoints.values())) != len(self._endpoints)
+            or len(set(self._databases.values())) != len(self._databases)
+        ):
+            raise ValueError("Duplicate Odoo configuration alias")
+
+    def target(self, endpoint_ref: str, database_ref: str, credential_ref: str) -> tuple[str, str]:
+        if credential_ref not in self._credential_refs:
+            raise RegistryError("connection_unavailable")
+        try:
+            return self._endpoints[endpoint_ref], self._databases[database_ref]
+        except KeyError:
+            raise RegistryError("connection_unavailable") from None
+
+    def secret(self, reference: str) -> SecretStr:
+        if reference not in self._credential_refs:
+            raise RegistryError("connection_unavailable")
+        try:
+            value = self._read_secret(reference)
+        except Exception:
+            raise RegistryError("connection_unavailable") from None
+        if not isinstance(value, str) or not re.fullmatch(r"[!-~]{16,512}", value):
+            raise RegistryError("connection_unavailable")
+        return SecretStr(value)
+
+
+def _scope_values(principal: Principal) -> tuple[str, str]:
+    return principal.scope.tenant_id, principal.scope.gestoria_company_id
+
+
+def _scoped_row(connection: sqlite3.Connection, principal: Principal, connection_id: str) -> sqlite3.Row:
+    row = connection.execute(
+        "SELECT * FROM odoo_connections WHERE tenant_id = ? AND company_id = ? AND id = ?",
+        (*_scope_values(principal), connection_id),
+    ).fetchone()
+    if row is None:
+        raise RegistryError("not_found")
+    return row
+
+
+def _public(row: sqlite3.Row, scope: Scope) -> PublicConnection:
+    return PublicConnection(
+        connection_id=row["id"], scope=scope, state=row["state"], created_at=row["created_at"],
+        revision=row["revision"],
+    )
+
+
+class ConnectionRegistry:
+    def __init__(self, database: Database, catalog: ServerCatalog):
+        self.database = database
+        self.catalog = catalog
+
+    def register(self, principal: Principal, binding: OdooBinding) -> PublicConnection:
+        if principal.role != "owner":
+            raise RegistryError("denied")
+        if principal.scope != binding.scope:
+            raise RegistryError("not_found")
+        with self.database.transaction() as connection:
+            scope = _scope_values(principal)
+            if not connection.execute(
+                "SELECT 1 FROM odoo_company_scopes WHERE tenant_id = ? AND company_id = ?", scope
+            ).fetchone():
+                raise RegistryError("not_found")
+            self.catalog.target(binding.endpoint_ref, binding.database_ref, binding.credential_ref)
+            try:
+                connection.execute(
+                    """
+                    INSERT INTO odoo_connections(
+                        id, tenant_id, company_id, endpoint_ref, database_ref, credential_ref, odoo_company_id,
+                        state, revision, created_at
+                    ) VALUES (?, ?, ?, ?, ?, ?, ?, 'pending_validation', 0, ?)
+                    """,
+                    (
+                        binding.connection_id, *scope, binding.endpoint_ref, binding.database_ref,
+                        binding.credential_ref, binding.odoo_company_id, now(),
+                    ),
+                )
+            except sqlite3.IntegrityError:
+                raise RegistryError("connection_conflict") from None
+            return _public(_scoped_row(connection, principal, binding.connection_id), principal.scope)
+
+    def get(self, principal: Principal, connection_id: str) -> PublicConnection:
+        with self.database.connection() as connection:
+            return _public(_scoped_row(connection, principal, connection_id), principal.scope)
+
+    def change(
+        self, principal: Principal, change: ConnectionChange, *, credential_ref: str | None
+    ) -> PublicConnection:
+        """Rotate the credential reference, or disable when no replacement is given."""
+        if principal.role != "owner":
+            raise RegistryError("denied")
+        with self.database.transaction() as connection:
+            row = _scoped_row(connection, principal, change.connection_id)
+            if row["revision"] != change.expected_revision:
+                raise RegistryError("revision_conflict")
+            if credential_ref is None:
+                credential_ref = row["credential_ref"]
+                state = "disabled"
+            else:
+                if row["state"] == "disabled":
+                    raise RegistryError("connection_unavailable")
+                self.catalog.target(row["endpoint_ref"], row["database_ref"], credential_ref)
+                state = "pending_validation"
+            connection.execute(
+                """
+                UPDATE odoo_connections SET credential_ref = ?, state = ?, revision = revision + 1
+                WHERE tenant_id = ? AND company_id = ? AND id = ? AND revision = ?
+                """,
+                (credential_ref, state, *_scope_values(principal), change.connection_id, change.expected_revision),
+            )
+            return _public(_scoped_row(connection, principal, change.connection_id), principal.scope)
+
+    def resolve_read(self, principal: Principal, connection_id: str) -> ResolvedConnection:
+        with self.database.connection() as connection:
+            row = _scoped_row(connection, principal, connection_id)
+            if row["state"] != "active":
+                raise RegistryError("connection_unavailable")
+        origin, database = self.catalog.target(row["endpoint_ref"], row["database_ref"], row["credential_ref"])
+        return ResolvedConnection(
+            public=_public(row, principal.scope), origin=origin, database_name=database,
+            api_key=self.catalog.secret(row["credential_ref"]), odoo_company_id=row["odoo_company_id"],
+        )
diff --git a/docs/odoo-adapter/c04/README.md b/docs/odoo-adapter/c04/README.md
new file mode 100644
index 0000000..dabea7b
--- /dev/null
+++ b/docs/odoo-adapter/c04/README.md
@@ -0,0 +1,21 @@
+# C04 · Contratos tipados de lectura, staging y contactos
+
+Estado: primer corte de C04 para revisión, dependiente del cierre de C02/C03. Incluye DTOs y esquemas. La validación de permisos, la persistencia y el transporte corresponden a fases posteriores.
+
+| Contrato | Uso |
+| --- | --- |
+| `PublicConnection`, `OdooBinding` | Proyección de conexión autorizada y binding interno separado. Las referencias de endpoint, base y credencial permanecen en el servidor. |
+| `CapabilityReport` | Resultado por capacidad con estados explícitos para soporte, ausencia, denegación y falta de evidencia. |
+| `SyncCursor`, `SourceRef`, `ExternalObjectLink` | Paginación por fecha/ID y procedencia por conexión, modelo e ID remoto. La pertenencia del cursor y del binding a la empresa se comprueba antes de ejecutar la operación. |
+| `ImportedEconomicFact`, `Money` | Evidencia ERP en staging con importe decimal en texto. Conserva el estado ERP y exige revisión local pendiente. |
+| `OperationEnvelope`, `ReadResult` | Sobre interno creado por el servidor tras resolver identidad y scope. Comandos de lectura cerrados y resultados discriminados, sin dominios, métodos o contexto ORM libre. |
+| `ContactPreviewRequest`, `ContactPreview`, `ApprovedContactWrite` | Candidato editable separado de la ejecución interna, que referencia una previsualización persistida y su hash, la aprobación humana y la clave idempotente. |
+| `ContactWriteResult` | Resultado confirmado, rechazo o reconciliación requerida. El resultado incierto carece de ID remoto y de instrucción de reintento. |
+
+El futuro ejecutor debe verificar que la aprobación existe, pertenece al scope correcto, sigue vigente y corresponde al hash de la previsualización. Persistencia, ejecución, reconciliación y contratos para otras mutaciones quedan pendientes. Los DTOs aún no se usan en la API de Gestoría ni en el SDK TypeScript.
+
+## Comprobaciones
+
+- `python -m unittest discover -s tests -v` ejecuta la suite y los casos de contratos.
+- `python -m scripts.export_odoo_contracts` emite los esquemas JSON del primer corte desde la raíz del repo. Las referencias de credenciales y el binding interno quedan fuera de la exportación.
+- Prueba local del 10 de noviembre de 2026: 30 pruebas Python aprobadas y serialización de un sobre y un hecho económico mediante Python → JSON Node → Python con conservación de `"100.10"`. La prueba de serialización acredita el formato JSON, con el consumo tipado desde el SDK pendiente.
