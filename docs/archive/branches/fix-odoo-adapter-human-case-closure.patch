diff --git a/scripts/simulation/probe.mjs b/scripts/simulation/probe.mjs
new file mode 100644
index 0000000..349f891
--- /dev/null
+++ b/scripts/simulation/probe.mjs
@@ -0,0 +1,61 @@
+import assert from "node:assert/strict";
+import { mkdir, readdir, readFile, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { Hono } from "hono";
+
+const env = process.env;
+const moduleUrl = name => pathToFileURL(path.join(env.GESTORIA_PROBE_CHECKOUT, "typescript", "dist", name));
+// Reuse Hono installed in the scratch consumer when loading the packaged adapter.
+const scratch = new URL("./adapter/", import.meta.url);
+await mkdir(scratch, { recursive: true });
+for (const filename of (await readdir(moduleUrl(""))).filter(name => name.endsWith(".js"))) {
+  await writeFile(new URL(filename, scratch), await readFile(moduleUrl(filename)));
+}
+await writeFile(new URL("package.json", scratch), JSON.stringify({ type: "module" }));
+const { Gestoria } = await import(new URL("index.js", scratch));
+const { agentTools } = await import(new URL("agents.js", scratch));
+const { gestoriaRoutes } = await import(new URL("hono.js", scratch));
+const agent = new Gestoria(env.GESTORIA_PROBE_URL, env.GESTORIA_PROBE_AGENT);
+const owner = new Gestoria(env.GESTORIA_PROBE_URL, env.GESTORIA_PROBE_OWNER);
+const a = env.GESTORIA_PROBE_A;
+const b = env.GESTORIA_PROBE_B;
+const app = new Hono();
+app.use("/api/*", async (ctx, next) => {
+  if (ctx.req.header("X-Synthetic-Actor") !== "agent-a") return ctx.json({ error: "Unauthorized" }, 401);
+  await next();
+});
+app.route("/api", gestoriaRoutes(async () => agent));
+const headers = { "X-Synthetic-Actor": "agent-a", "Content-Type": "application/json" };
+const request = (route, payload) => app.request(route, {
+  method: payload === undefined ? "GET" : "POST",
+  headers,
+  body: payload === undefined ? undefined : JSON.stringify(payload),
+});
+assert.equal((await app.request("/api/companies")).status, 401);
+assert.equal((await request("/api/companies")).status, 200);
+assert.equal((await request(`/api/companies/${b}/cases`)).status, 404);
+const root = `/api/companies/${a}`;
+const tools = agentTools(agent, a);
+const record = {
+  external_id: "sdk-probe-1", operation_date: "2026-03-31", kind: "income",
+  description: "Venta sintética", tax_kind: "none", base_amount: "100.10", tax_amount: "0",
+};
+await tools.create_tax_record.execute(record);
+assert.equal((await request(`${root}/tax-records`, record)).status, 409);
+assert.equal((await tools.list_tax_records.execute()).length, 1);
+const draft = await tools.create_case.execute({ title: "Expediente sintético" });
+const casePath = `${root}/cases/${draft.id}`;
+await tools.submit_review.execute({ caseId: draft.id, revision: 0 });
+const review = { revision: 1, decision: "approve", notes: "Aprobación sintética de prueba", verified_source_ids: [] };
+assert.equal((await request(`${casePath}/review`, review)).status, 403);
+await owner.request(`${casePath}/review`, review);
+const fixed = env.GESTORIA_PROBE_VARIANT === "fixed";
+assert.equal("close_reviewed_case" in tools, !fixed);
+assert.equal((await request(`${casePath}/close`, { revision: 2 })).status, fixed ? 403 : 200);
+if (fixed) assert.equal((await owner.request(`${casePath}/close`, { revision: 2 })).outcome, "internal_complete");
+console.log(`${env.GESTORIA_PROBE_VARIANT}: SDK + Hono + FastAPI synthetic checks PASS (agent close ${fixed ? "denied" : "reproduced"})`);
+if (env.GESTORIA_PROBE_AGENTE) {
+  const { simulate } = await import("./runtime-probe.mts");
+  await simulate(env.GESTORIA_PROBE_AGENTE, tools, draft.id);
+}
diff --git a/scripts/simulation/run.py b/scripts/simulation/run.py
new file mode 100644
index 0000000..73ea56e
--- /dev/null
+++ b/scripts/simulation/run.py
@@ -0,0 +1,83 @@
+import argparse
+import json
+import os
+from pathlib import Path
+import secrets
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+from fastapi.testclient import TestClient
+import uvicorn
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Run the disposable Agente + Gestoría compatibility probe")
+    parser.add_argument("--gestoria", type=Path, required=True, help="Checkout with a built TypeScript SDK")
+    parser.add_argument("--agente", type=Path, required=True, help="Checkout with its locked dependencies installed")
+    parser.add_argument("--baseline", action="store_true", help="Expect and reproduce the old agent case closure")
+    args = parser.parse_args()
+    checkout = args.gestoria.resolve()
+    agente = args.agente.resolve()
+    variant = "baseline" if args.baseline else "fixed"
+    loader = agente / "node_modules/tsx/dist/loader.mjs"
+    hono = agente / "node_modules/hono"
+    if not loader.is_file() or not (hono / "package.json").is_file():
+        parser.error("Install Agente's locked dependencies before running the probe")
+    sys.path.insert(0, str(checkout))
+    from agntia_gestoria.app import create_app
+
+    with tempfile.TemporaryDirectory(prefix="gestoria-sdk-probe-") as directory:
+        scratch = Path(directory)
+        shutil.copytree(hono, scratch / "node_modules/hono")
+        for filename in ("probe.mjs", "runtime-probe.mts"):
+            shutil.copy2(Path(__file__).with_name(filename), scratch / filename)
+        owner_token = secrets.token_hex(24)
+        agent_token = secrets.token_hex(24)
+        os.environ.update(
+            GESTORIA_DATA_DIR=str(scratch / "data"), GESTORIA_OWNER_TOKEN=owner_token,
+            GESTORIA_ACTORS_JSON="{}", ODOO_ADAPTER_ENABLED="false",
+        )
+        with TestClient(create_app()) as fixture:
+            headers = {"Authorization": f"Bearer {owner_token}"}
+            company_a, company_b = [
+                fixture.post("/api/companies", headers=headers, json={"name": name, "legal_form": "autonomo"}).json()["id"]
+                for name in ("Empresa sintética A", "Empresa sintética B")
+            ]
+        os.environ["GESTORIA_ACTORS_JSON"] = json.dumps({
+            agent_token: {"id": "agent-a", "role": "agent", "companies": [company_a]},
+        })
+        with socket.socket() as listener:
+            listener.bind(("127.0.0.1", 0))
+            server = uvicorn.Server(uvicorn.Config(create_app(), log_level="warning"))
+            thread = threading.Thread(target=server.run, kwargs={"sockets": [listener]}, daemon=True)
+            thread.start()
+            try:
+                for _ in range(200):
+                    if server.started:
+                        break
+                    if not thread.is_alive():
+                        raise RuntimeError("Uvicorn terminated before readiness")
+                    time.sleep(0.025)
+                else:
+                    raise RuntimeError("Uvicorn was not ready")
+                subprocess.run(
+                    ["node", "--import", loader.as_uri(), str(scratch / "probe.mjs")],
+                    env={**os.environ, "GESTORIA_PROBE_URL": f"http://127.0.0.1:{listener.getsockname()[1]}",
+                         "GESTORIA_PROBE_AGENT": agent_token, "GESTORIA_PROBE_OWNER": owner_token,
+                         "GESTORIA_PROBE_A": company_a, "GESTORIA_PROBE_B": company_b,
+                         "GESTORIA_PROBE_VARIANT": variant, "GESTORIA_PROBE_CHECKOUT": str(checkout),
+                         "GESTORIA_PROBE_AGENTE": str(agente)},
+                    check=True, timeout=90,
+                )
+            finally:
+                server.should_exit = True
+                thread.join(10)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/simulation/runtime-probe.mts b/scripts/simulation/runtime-probe.mts
new file mode 100644
index 0000000..b2a8865
--- /dev/null
+++ b/scripts/simulation/runtime-probe.mts
@@ -0,0 +1,81 @@
+import assert from "node:assert/strict";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+
+export async function simulate(
+  checkout: string, tools: { list_cases: { execute: () => Promise<unknown> } }, caseId: string,
+) {
+  const source = (relative: string) => pathToFileURL(path.join(checkout, "apps/server/src/engine", relative)).href;
+  const { AgentRuntimeManager } = await import(source("agents/runtime.ts"));
+  const { CapabilityRunner } = await import(source("execution/capability-runner.ts"));
+  const { Executor } = await import(source("execution/executor.ts"));
+  const manager = new AgentRuntimeManager();
+  const runtime = await manager.spawn({ tenantId: "tenant-a", owner: "owner-a", roleId: "gestoria-reader" });
+  const other = await manager.spawn({ tenantId: "tenant-b", owner: "owner-b", roleId: "gestoria-reader" });
+  const context = (execution: typeof runtime) => ({
+    ...execution, role: "agent", actorId: "synthetic-agent", requestId: execution.correlationId,
+  });
+  const capability = "gestoria.cases.read";
+  const registry = {
+    get: async (name: string) => name === capability
+      ? { id: name, requiresApproval: false, idempotency: "idempotent", sideEffects: [] }
+      : null,
+  };
+  let calls = 0;
+  const executors = new Map([[capability, {
+    run: async (ctx: { runtimeId: string }, _cap: string, inputs: Record<string, unknown>) => {
+      assert.equal(ctx.runtimeId, runtime.runtimeId);
+      if (Object.keys(inputs).length) throw new Error("unexpected tool inputs");
+      calls++;
+      const cases = await tools.list_cases.execute() as Array<{ id: string }>;
+      assert.ok(cases.some(entry => entry.id === caseId));
+      return cases;
+    },
+  }]]);
+  const governance = {
+    canExecuteTool: async (actor: { tenantId: string; runtimeId: string }) => ({
+      allowed: actor.tenantId === runtime.tenantId && actor.runtimeId === runtime.runtimeId,
+    }),
+    canExecuteAction: async () => ({ allowed: false }),
+  };
+  const runner = new CapabilityRunner(registry, executors, governance, async () => ({ name: "Synthetic reader" }));
+  const step = (id: string, capabilityId: string, inputs = {}) => ({
+    id, title: id, capabilityId, inputs, dependsOn: [], status: "pending",
+  });
+  const read = step("read", capability);
+  assert.equal((await new Executor(runner).execute(context(runtime), { steps: [read] })).status, "succeeded");
+  await assert.rejects(runner.run(context(other), read), /authz denied/);
+  await assert.rejects(runner.run(context(runtime), step("close", "gestoria.case.close")), /not found/);
+  await assert.rejects(runner.run(context(runtime), step("read", capability, { companyId: "other" })), /unexpected/);
+  assert.equal(calls, 1);
+  console.log("Agente runtime + CapabilityRunner + SDK + FastAPI: tenant-scoped read PASS");
+
+  // Disposable effect counter models a commit whose acknowledgement never arrived.
+  const rows = new Map<string, Record<string, unknown>>();
+  const key = (tenant: string, kind: string, id: string) => JSON.stringify([tenant, kind, id]);
+  const db = {
+    get: async (tenant: string, kind: string, id: string) => rows.get(key(tenant, kind, id)) ?? null,
+    put: async (tenant: string, kind: string, row: { id: string }) => rows.set(key(tenant, kind, row.id), row),
+    insertIfAbsent: async (tenant: string, kind: string, row: { id: string }) => {
+      const id = key(tenant, kind, row.id);
+      if (rows.has(id)) return false;
+      rows.set(id, row);
+      return true;
+    },
+  };
+  const effect = "synthetic.external.effect";
+  let committed = 0;
+  const writeRunner = new CapabilityRunner(
+    { get: async () => ({ id: effect, requiresApproval: false, idempotency: "non_idempotent", sideEffects: [{ kind: "external_write" }] }) },
+    new Map([[effect, { run: async () => { committed++; throw new Error("synthetic acknowledgement lost after commit"); } }]]),
+    undefined, undefined, db,
+  );
+  const write = step("write", effect);
+  await assert.rejects(writeRunner.run(context(runtime), write), /acknowledgement lost/);
+  await assert.rejects(writeRunner.run(context(runtime), write), /acknowledgement lost/);
+  assert.equal(committed, 2);
+  console.log("Diagnostic: existing Agente runner retried a failed claim after a simulated commit with lost acknowledgement");
+  await manager.complete(runtime.runtimeId, 1);
+  await manager.complete(other.runtimeId, 1);
+  assert.equal(manager.get(runtime.runtimeId), undefined);
+}
