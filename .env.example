GESTORIA_DATA_DIR=./data
# Obligatorio para acceso remoto. Al configurarlo también se exige en localhost.
GESTORIA_OWNER_TOKEN=
# Opcional: JSON de credenciales separadas. Genera tokens largos fuera del chat.
# Cada clave es un token; cada valor declara identidad, rol y empresas autorizadas.
# Nunca copies este ejemplo con tokens de prueba a producción.
GESTORIA_ACTORS_JSON={}
GESTORIA_MAX_UPLOAD_MB=20
